/**
 * Add entity id to triplestore.
 */
function wisski_core_update_8006(&$sandbox) {
  $val = \Drupal::state()->get('wisski_update_last_key');
  if (empty($val)) {
    $val = 0;
  }

  $result = \Drupal::database()->select("wisski_salz_id2uri", 't')->fields('t')->condition('eid', $val, '>')->orderBy('eid', 'ASC')->execute();
  $adapters = [];

  while ($thing = $result->fetchObject()) {
    $adapter_id = $thing->adapter_id;
    $adapter = NULL;
    $eid = $thing->eid;
    $uri = $thing->uri;

    // If there is nothing to do, skip it.
    if (empty($eid) || empty($uri)) {
      continue;
    }

    if (!isset($adapters[$adapter_id])) {
      $adapter = \Drupal::service('entity_type.manager')->getStorage('wisski_salz_adapter')->load($adapter_id);
      $adapters[$adapter_id] = $adapter;
    }
    else {
      $adapter = $adapters[$adapter_id];
    }

    if ($adapter) {
      $adapter->getEngine()->setBaseFieldFromStoreForUri($uri, "eid", $eid);
    }
    \Drupal::state()->set('wisski_update_last_key', $eid);
  }
  \Drupal::state()->delete('wisski_update_last_key');
  // drupal_set_installed_schema_version('wisski_core', '8006');.
}

/**
 * Add wisski uri field to entity.
 */
function wisski_core_update_8007(&$sandbox) {
  $definition_manager = \Drupal::entityDefinitionUpdateManager();
  $newStorage = BaseFieldDefinition::create('uri')
    ->setLabel(t('WissKI URI'))
    ->setDescription(t('The WissKI URI from the TS (in case you need it)'))
    ->setReadOnly(TRUE)
    ->setDisplayOptions('view', [
      'region' => 'hidden',
      'label' => 'hidden',
      'type' => 'string',
      'weight' => -5,
    ])
    ->setDisplayConfigurable('view', TRUE);

  $definition_manager->installFieldStorageDefinition('wisski_uri', 'wisski_individual', 'wisski_core', $newStorage);
}

/**
 * Update language in entity field properties table.
 */
function wisski_core_update_8008(&$sandbox) {
  $lang = \Drupal::service('language_manager')->getCurrentLanguage()->getId();

  $result = \Drupal::database()->update("wisski_entity_field_properties")->fields(['lang' => $lang])->condition('lang', 'und', '=')->execute();
  // UPDATE `wisski_entity_field_properties` SET `lang` = 'en' WHERE `lang` = 'und'.
}

/**
 * Force install of WissKI autocomplete module.
 */
function wisski_core_update_8009(&$sandbox) {
  \Drupal::service('module_installer')->install(['wisski_autocomplete']);
  $settings = \Drupal::configFactory()->getEditable('wisski_core.settings');
  $settings->set('wisski_enableAutocompleteEverywhere', TRUE);
  $settings->save();
}

/**
 * Add primary key to wisski_core_ontology_namespaces (short_name).
 */
function wisski_core_update_8010(&$sandbox) {
  // To reset the database schema version go to table "key_value", download blob, alter the version number, upload the blob.
  // \Drupal::keyValue('system.schema')->set('wisski_core', (int) 8009); should have been working...
  $connection = Database::getConnection();
  $select = $connection->select('wisski_core_ontology_namespaces', 't');
  $select->addExpression('MAX(LENGTH(short_name))');
  $result = $select->execute()->fetchField();
  if ($result > 32) {
    throw new \Exception('There is an ontology namespace short name exceeding 32 characters, go to Manage > Configuration > WissKI Ontology > Display Namespaces and shorten the corresponding short names.');
  }

  $schema = $connection->schema();
  $schema->changeField(
    'wisski_core_ontology_namespaces',
    'short_name',
    'short_name',
    [
      'description' => 'Short name of the namespace.',
      'type' => 'char',
      'length' => 32,
      'not null' => TRUE,
    ],
    [
      'primary key' => [
        'short_name',
      ],
    ]
  );
}

/**
 * Add eid as primary key to wisski_preview_images.
 */
function wisski_core_update_8011(&$sandbox) {
  $connection = Database::getConnection();
  $schema = $connection->schema();
  try {
    $schema->addPrimaryKey('wisski_preview_images', ['eid']);
  }
  catch (IntegrityConstraintViolationException $exception) {
    throw new Exception('Can not add primary key eid to wisski_preview_images. Please remove duplicate entries from table.');
  }
}

/**
 * Add eid as primary key to wisski_calling_bundles.
 */
function wisski_core_update_8012(&$sandbox) {
  $connection = Database::getConnection();
  $schema = $connection->schema();
  try {
    $schema->addPrimaryKey('wisski_calling_bundles', ['eid']);
  }
  catch (IntegrityConstraintViolationException $exception) {
    \Drupal::messenger()->addMessage("Found multiple bundles for some EIDs. We will change that for you.");
    // Get eids that occur more than once.
    $results = $connection->select('wisski_calling_bundles', 't')->fields('t', ['eid'])->groupBy('eid')->having("count(eid) > :limit", [':limit' => 1])->execute()->fetchAll();
    $doubledEids = [];
    $f = function ($result) {
      return $result->eid;
    };
    $doubledEids = array_map($f, $results);
    // Delete all rows that have the same EID.
    $connection->delete('wisski_calling_bundles')->condition('eid', $doubledEids, 'IN')->execute();

    // Make the eid the primary key.
    $schema->addPrimaryKey('wisski_calling_bundles', ['eid']);
  }
}

/**
 * Add eid, bid, fid as primary key to wisski_entity_field_properties.
 */
function wisski_core_update_8013(&$sandbox) {
  $connection = Database::getConnection();
  $schema = $connection->schema();
  try {
    $schema->addPrimaryKey('wisski_entity_field_properties', [
      'eid',
      'bid',
      'fid',
      'delta',
      'ident',
    ]);
  }
  catch (IntegrityConstraintViolationException $exception) {
    \Drupal::messenger()->addMessage("Found multiple values for intended primary keys (eid, bid, fid). Please remove these rows in the 'wisski_entity_field_properties' table, or contact your system administrator.");
    throw new Exception("Found multiple values for intended primary keys (eid, bid, fid). Please remove these rows in the 'wisski_entity_field_properties' table, or contact your system administrator.");
  }
}

/**
 * Implements hook_schema().
 */
function wisski_core_schema() {

  $schema['wisski_entity_map'] = [
    'description' => 'generates a serial number for those entity IDs which have a generated title',
    'fields' => [
      'num' => [
        'description' => 'the Serial Number for the generated title',
        'type' => 'serial',
        'size' => 'normal',
        'not null' => TRUE,
      ],
      'eid' => [
        'description' => 'the Entity ID',
        'type' => 'int',
        'size' => 'big',
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['num'],
  ];

  $schema['wisski_title_n_grams'] = [

    'description' => 'Stores n-grams of generated entity titles for search and index purposes',
    'fields' => [
      'ent_num' => [
        'description' => 'Entity Serial Number from wisski_entity_map',
        'type' => 'int',
        'size' => 'big',
        'not null' => TRUE,
      ],
      'bundle' => [
        'description' => 'Bundle Name',
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'default' => 'default',
      ],
      'ngram' => [
        'description' => 'n-gram from the title',
        'type' => 'char',
        'length' => 128,
        'not null' => TRUE,
      ],
      'n' => [
        'description' => 'the length of the n-gram',
        'type' => 'int',
        'size' => 'normal',
        'not null' => TRUE,
      ],
      'lang' => [
        'description' => 'the language of the title',
        'type' => 'char',
        'length' => 16,
        'not null' => TRUE,
        'default' => 'und',
      ],
    ],
    'primary key' => ['ent_num', 'bundle', 'ngram', 'lang'],
    'indexes' => [
      'ngrams' => ['ngram', 'n', 'lang'],
      'entities' => ['ent_num', 'bundle', 'lang'],
    ],
  ];

  $schema['wisski_calling_bundles'] = [

    'description' => 'Caches the calling bundle for individuals so that we can decide on the correct visualization',
    'fields' => [
      'eid' => [
        'description' => 'Entity ID',
        'type' => 'int',
        'size' => 'big',
        'not null' => TRUE,
      ],
      'bid' => [
        'description' => 'bundle name / ID',
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['eid'],
    'indexes' => [
      'eid' => ['eid'],
      'bid' => [['bid', 64]],
    ],
  ];

  $schema['wisski_preview_images'] = [

    'description' => 'Caches the URI of the preview image for individuals',
    'fields' => [
      'eid' => [
        'description' => 'Entity ID',
        'type' => 'int',
        'size' => 'big',
        'not null' => TRUE,
      ],
      'image_uri' => [
        'description' => 'image URI',
        'type' => 'varchar',
        'length' => 1023,
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['eid'],
    'indexes' => [
      'eid' => ['eid'],
      'bid' => [['image_uri', 128]],
    ],
  ];

  $schema['wisski_entity_field_properties'] = [

    'description' => 'Saves secondary field data for WissKI Entities. This includes all the field properties that are set by the user',
    'fields' => [
      'eid' => [
        'description' => 'Entity ID',
        'type' => 'int',
        'size' => 'big',
        'not null' => TRUE,
      ],
      'bid' => [
        'description' => 'bundle name / ID',
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'fid' => [
        'description' => 'field name / ID',
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'delta' => [
        'description' => 'field item weight',
        'type' => 'int',
      ],
      'ident' => [
        'description' => 'A string that identifies this field item, will mostly be the disamb/group URI',
        'type' => 'text',
        'length' => 1023,
        'not null' => TRUE,
      ],
      'properties' => [
        'description' => 'array of field properties',
        'type' => 'text',
        'serialize' => TRUE,
      ],
      'lang' => [
        'description' => 'the language of the field property table entry',
        'type' => 'char',
        'length' => 16,
        'not null' => TRUE,
        'default' => \Drupal::service('language_manager')->getCurrentLanguage()->getId(),
      ],
    ],
    'primary key' => [
      'eid',
      'bid',
      'fid',
      'delta',
      'ident',
    ],
    'indexes' => [
      'eid' => ['eid'],
      'bid' => [['bid', 64]],
      'fid' => [['fid', 64]],
    ],
  ];

  $schema['wisski_core_ontology_namespaces'] = [

    'description' => 'Saves the namespaces on ontology load.',
    'fields' => [
      'short_name' => [
        'description' => 'Short name of the namespace.',
        'type' => 'char',
        'length' => 32,
        'not null' => TRUE,
      ],
      'long_name' => [
        'description' => 'Full URI of the namespace.',
        'type' => 'text',
        'length' => 1023,
        'not null' => TRUE,
      ],
    ],
    'primary key' => [
      'short_name',
    ],
  ];

  return $schema;
}
